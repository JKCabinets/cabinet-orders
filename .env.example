# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://your-project.vercel.app
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# ─── Shopify ──────────────────────────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret
# Optional — only needed if you use the public app OAuth flow rather than a
# single admin API token. Most deployments leave these blank.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ─── Cron job security ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
CRON_SECRET=generate_with_openssl_rand_base64_32

# ─── Admin PIN for backwards stage moves ─────────────────────────────────────
# Required by both /api/orders/bulk and /api/orders/[id] when moving an order
# to an earlier stage. If unset, the code falls back to a legacy default —
# always set this in production.
ADMIN_BACKWARD_PIN=set_a_5_digit_pin

# ─── Public quote-form webhook ────────────────────────────────────────────────
# Optional shared secret for the public /api/webhooks/quote-form endpoint.
# If set, the inbound form must include {"secret":"<value>"} for the request
# to be accepted. Constant-time compared.
QUOTE_WEBHOOK_SECRET=
# Comma-separated list of hostnames the quote-form webhook will accept as
# legacy `attachment_url` values. Anything outside this list is dropped.
QUOTE_LEGACY_URL_HOSTS=

# ─── Microsoft Teams digest ──────────────────────────────────────────────────
# Power Automate "When a Teams webhook request is received" flow URL. The
# cron POSTs the morning digest here. Must be a *.logic.azure.com,
# *.webhook.office.com, *.azure-apim.net, or *.api.powerplatform.com URL.
TEAMS_WEBHOOK_URL=

# ─── Upstash Redis (rate limiting) ────────────────────────────────────────────
# Get these from upstash.com → create a Redis database → REST API
# Without these, rate limiting falls back to in-memory (resets on cold start)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
