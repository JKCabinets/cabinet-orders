# Actual secret values for Kamal deployment.
# 
# THIS FILE IS GITIGNORED. DO NOT COMMIT.
# 
# Copy real values here from .env.production.local (or wherever you store
# them). Kamal reads this file at deploy time via .kamal/secrets.
#
# Format: one KEY=VALUE per line. No quotes around values (Kamal will
# inject them as-is into the container).

# GitHub Personal Access Token with write:packages scope
# Generate at: https://github.com/settings/tokens
KAMAL_REGISTRY_PASSWORD=REPLACE_WITH_GHCR_TOKEN

# Supabase
SUPABASE_URL=REPLACE
SUPABASE_SERVICE_ROLE_KEY=REPLACE

# NextAuth
NEXTAUTH_SECRET=REPLACE

# Cron + admin
CRON_SECRET=REPLACE
ADMIN_BACKWARD_PIN=REPLACE

# Shopify
SHOPIFY_WEBHOOK_SECRET=REPLACE
SHOPIFY_CLIENT_ID=REPLACE
SHOPIFY_CLIENT_SECRET=REPLACE
SHOPIFY_STORE_DOMAIN=REPLACE

# Quote webhook
QUOTE_WEBHOOK_SECRET=REPLACE

# Teams notifications
TEAMS_WEBHOOK_URL=REPLACE

# Upstash Redis
UPSTASH_REDIS_REST_URL=REPLACE
UPSTASH_REDIS_REST_TOKEN=REPLACE
