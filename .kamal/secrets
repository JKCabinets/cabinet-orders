# Kamal secrets loader.
#
# This file is committed to git but contains only the LOADER LOGIC,
# not actual secret values. The values themselves live in `.env.kamal`
# (which IS gitignored).
#
# Kamal evaluates this file as a shell script on every deploy command.
# Each line that exports an env var becomes available for reference
# from config/deploy.yml under the `secret:` list.
#
# To add a new secret:
#   1. Add a line to .env.kamal:   FOO=bar
#   2. Add a line here:            FOO=$(grep '^FOO=' .env.kamal | cut -d '=' -f 2-)
#   3. Reference it in deploy.yml under env/secret

# Bail out loudly if .env.kamal is missing — better than a confusing
# "blank value" error mid-deploy.
if [ ! -f .env.kamal ]; then
  echo "ERROR: .env.kamal not found in $(pwd)" >&2
  echo "       This file holds your actual secret values. It must exist locally" >&2
  echo "       but is .gitignored. See deploy docs." >&2
  exit 1
fi

# Helper to extract a single key. Handles values containing '=' correctly
# (we use cut -d '=' -f 2- to keep everything after the first '=').
_get() {
  grep "^$1=" .env.kamal | cut -d '=' -f 2-
}

KAMAL_REGISTRY_PASSWORD=$(_get KAMAL_REGISTRY_PASSWORD)
SUPABASE_URL=$(_get SUPABASE_URL)
SUPABASE_SERVICE_ROLE_KEY=$(_get SUPABASE_SERVICE_ROLE_KEY)
NEXTAUTH_SECRET=$(_get NEXTAUTH_SECRET)
CRON_SECRET=$(_get CRON_SECRET)
ADMIN_BACKWARD_PIN=$(_get ADMIN_BACKWARD_PIN)
SHOPIFY_WEBHOOK_SECRET=$(_get SHOPIFY_WEBHOOK_SECRET)
SHOPIFY_CLIENT_ID=$(_get SHOPIFY_CLIENT_ID)
SHOPIFY_CLIENT_SECRET=$(_get SHOPIFY_CLIENT_SECRET)
SHOPIFY_STORE_DOMAIN=$(_get SHOPIFY_STORE_DOMAIN)
QUOTE_WEBHOOK_SECRET=$(_get QUOTE_WEBHOOK_SECRET)
TEAMS_WEBHOOK_URL=$(_get TEAMS_WEBHOOK_URL)
UPSTASH_REDIS_REST_URL=$(_get UPSTASH_REDIS_REST_URL)
UPSTASH_REDIS_REST_TOKEN=$(_get UPSTASH_REDIS_REST_TOKEN)
